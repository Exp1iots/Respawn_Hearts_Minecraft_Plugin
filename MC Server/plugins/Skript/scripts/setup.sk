# Variable Setup
variables:
    {maxRespawnHearts} = 15
    {defaultRespawnHearts} = 10
    {maxHearts} = 20
    {deathCooldownPeriod} = 5 minutes

on first join:
    set {RespawnHearts::%player%} to {defaultRespawnHeartss}

on join:
    if {RespawnHearts::%player%} does not exist:
        set {RespawnHearts::%player%} to {defaultRespawnHearts}