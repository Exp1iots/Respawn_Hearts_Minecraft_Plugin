command /respawn_heart:
    description: Give an Respawn Heart item to the player
    permission: op
    permission message: Hey, you can't do that!
    trigger:
        give {item::respawn_heart} to player

command /set_max_hearts <player> <integer>:
    description: Set a player's max hearts
    permission: op
    permission message: Hey, you can't do that!
    trigger:
        if arg-2 is greater than {maxHearts}:
            loop 3 times:
                send action bar "Sorry, %arg-1% has reached the maxium number of hearts" to player
                wait 1 second
        else:
            set max health of arg-1 to arg-2
            if arg-1's name ends with "s":
                loop 2 times:
                    send action bar "%arg-1%' max health has been set to %arg-2%" to player
                    wait 1 second
            else:
                loop 2 times:
                    send action bar "%arg-1%'s max health has been set to %arg-2%" to player
                    wait 1 second

command /set_respawn_hearts <player> <integer>:
    description: Set a player's RespawnHearts
    permission: op
    permission message: Hey, you can't do that!
    trigger:
        if arg-2 is greater than {maxRespawnHearts}:
            loop 3 times:
                send action bar "Sorry, %arg-1% has reached the maxium number of respawn hearts" to player
                wait 1 second
        else:
            set {RespawnHearts::%arg-1%} to arg-2
            if max health of arg-1 is less than {RespawnHearts::%arg-1%}:
                set max health of arg-1 to {RespawnHearts::%arg-1%}
            if arg-1's name ends with "s":
                loop 2 times:
                    send action bar "%arg-1%' respawn hearts has been set to %arg-2%" to player
                    wait 1 second
            else:
                loop 2 times:
                    send action bar "%arg-1%'s respawn hearts has been set to %arg-2%" to player
                    wait 1 second

command /health_stats:
    description: Show a player their health stats
    trigger:
        send "Your Health Stats"
        send "Your max health is %max health of player%/%{maxHearts}%" to player
        send "You have %{RespawnHearts::%player%}% respawn hearts."

command /health_stats_of <player>:
    description: Show health stats of another player
    permission: op
    permission message: Hey, you can't do that!
    trigger:
        if arg-1's name ends with "s":
            send "%arg-1%' Health Stats"
            send "%arg-1%' max health is %max health of arg-1%/%{maxHearts}%" to player
            send "%arg-1% has %{RespawnHearts::%arg-1%}% respawn hearts."
        else:
            send "%arg-1%'s Health Stats"
            send "%arg-1%'s max health is %max health of arg-1%/%{maxHearts}%" to player
            send "%arg-1% has %{RespawnHearts::%arg-1%}% respawn hearts."


# Debug/info commands

command /current_time:
    trigger:
        send "&7[&3INFO&7] &fTime: %time%" to player
        send "&7[&3INFO&7] &fNow: %now%" to player

command /enable_force_respawn <player>:
    permission: op
    permission message: Hey, you can't do that!
    trigger:
        force arg-1 to respawn

command /show_cooldown <player> <player>:
    permission: op
    permission message: Hey, you can't do that!
    trigger:
        send {cooldown.%arg-1%.%arg-2%} to player
        if {cooldown.%arg-1%.%arg-2%} does not exist:
            send "&7[&3INFO&7] &f{cooldown.%arg-1%.%arg-2%} does not exist" to player

command /clear_cooldown <player> <player>:
    trigger:
        if {cooldown.%arg-1%.%arg-2%} does not exist:
            send "&7[&3INFO&7] &f{cooldown.%arg-1%.%arg-2%} does not exist so there was nothing to delete" to player
            exit
        delete {cooldown.%arg-1%.%arg-2%}
        send "&7[&3INFO&7] &fCleared cooldown between %arg-1% and %arg-2%" to player